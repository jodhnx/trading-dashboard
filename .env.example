# =============================================================================
# Trading Dashboard — environment template
# Copy to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# --- Supabase (current key architecture) ---
# Project URL from Supabase → Project Settings → API
SUPABASE_URL=

# Publishable key (safe for the browser, still protected by RLS)
SUPABASE_PUBLISHABLE_KEY=

# Secret key (SERVER ONLY — never import this module from Client Components)
SUPABASE_SECRET_KEY=

# --- OpenAI (server only) ---
# News summaries (Phase 5) and structured trading analysis (Phase 8).
# Never import this into Client Components. Never send trading orders.
OPENAI_API_KEY=

# Structured-outputs-capable model. Do not hardcode in app logic.
OPENAI_MODEL=gpt-4o-mini

# --- Market data ---
# Primary provider: Twelve Data. If unset, the app uses MockMarketDataProvider.
TWELVE_DATA_API_KEY=

# auto | twelve-data | mock
# auto (default): Twelve Data when TWELVE_DATA_API_KEY is set.
# Without a key: mock in development, DATA UNAVAILABLE in production (never silent mock).
MARKET_DATA_PROVIDER=auto

# --- News ---
# Primary provider: NewsAPI.org. Architecture stays swappable via NewsProvider.
NEWS_API_KEY=

# auto | newsapi | mock
# auto (default): NewsAPI when NEWS_API_KEY is set.
# Without a key: mock in development, NEWS UNAVAILABLE in production (never silent mock).
NEWS_PROVIDER=auto

# --- Cron (server only) ---
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> to /api/cron/daily-pipeline (05:30 UTC).
# Never expose this value to the client bundle.
CRON_SECRET=

# --- Optional legacy aliases (resolved in src/lib/env, not required) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
